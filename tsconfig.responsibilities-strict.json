{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/features/responsibilities/**/*.ts",
    "src/features/responsibilities/**/*.tsx",
    "src/features/selftest/scenarios/responsibilities.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
